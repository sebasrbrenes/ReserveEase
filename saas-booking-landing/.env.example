# URL of the deployed booking app (saas-booking-app), without a trailing slash.
# The landing's "Sign in" / "Create account" buttons link to $VITE_APP_URL/login and /signup.
VITE_APP_URL=https://your-app.vercel.app

# Mailbox shown on the privacy, terms and contact links.
VITE_CONTACT_EMAIL=you@example.com

# Public URL of this landing, without a trailing slash. Used by share previews, robots.txt and sitemap.xml.
VITE_SITE_URL=https://reserve-ease-nwpq.vercel.app
