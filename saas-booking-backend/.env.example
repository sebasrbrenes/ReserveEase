# Copy to .env and fill in. Never commit the real file.
PORT=3001
FRONTEND_URL=http://localhost:3000

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notifications: anything other than "live" answers without sending email/SMS
NOTIFICATIONS_MODE=mock
NOTIFICATIONS_RATE_MAX=10
NOTIFICATIONS_RATE_WINDOW_MS=900000

# SendGrid (only used when NOTIFICATIONS_MODE=live)
SENDGRID_API_KEY=
FROM_EMAIL=

# Twilio (only used when NOTIFICATIONS_MODE=live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_TIMEZONE=America/Costa_Rica

# Lemon Squeezy webhook signing secret
SIGNING_SECRET_BACKEND=
