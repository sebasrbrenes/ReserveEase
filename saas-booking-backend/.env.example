# Copy to .env and fill in. Never commit the real file.
PORT=3001
FRONTEND_URL=http://localhost:3000

# Environment. "local" refuses to start unless the emulators below are set.
APP_ENV=local

# Firebase emulators (local development). For a real project, remove the two
# *_EMULATOR_HOST lines, change APP_ENV and FIREBASE_PROJECT_ID, and fill in
# the service account credentials below.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-reserveease

# Firebase Admin service account (real projects only)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notifications: anything other than "live" sends no email.
# The worker in server.js sends queued booking emails; with mock it only marks
# them "simulated". NOTIFICATIONS_WORKER=off disables it.
NOTIFICATIONS_MODE=mock
NOTIFICATIONS_WORKER=on

# Public booking creation: max attempts per IP per window
BOOKING_RATE_MAX=20
BOOKING_RATE_WINDOW_MS=900000

# Email through Resend (only used when NOTIFICATIONS_MODE=live).
# The API key needs "Sending access"; EMAIL_FROM must use a domain verified
# in Resend. Clients see the business name as sender, with this address.
# Free plan: 100 emails a day (UTC) and 3,000 a month; when the daily quota
# runs out the worker waits until the next day instead of failing.
RESEND_API_KEY=
EMAIL_FROM="ReserveEase <bookings@example.com>"
# Optional: where client replies go
EMAIL_REPLY_TO=

# Subscription billing (Paddle): Basic $15 USD/month plus the optional SMS
# add-on at $10 USD/month on the same subscription. Leave empty until the
# Paddle account exists: checkout then answers 503 and nothing is charged.
# PADDLE_ENV=sandbox while testing, production for real charges. The API key,
# price and webhook secret must all come from that same environment.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Monthly $15 price of the Basic product (PADDLE_PRICE_ID still works).
PADDLE_PRICE_ID_BASIC=
# Monthly $10 price of the SMS Reminders product. Empty = add-on not offered.
PADDLE_PRICE_ID_SMS=
# Secret of the notification destination pointing at
# https://<backend>/api/v1/billing/paddle/webhook
PADDLE_WEBHOOK_SECRET=

# From this date (YYYY-MM-DD, UTC) businesses without an active subscription
# are paused: the dashboard only shows Settings and the booking page stops
# taking bookings. Empty = nobody is paused. Ignored while Paddle is not set
# up. Give owners the notice the terms promise (30 days) before it arrives.
BILLING_ENFORCEMENT_DATE=

# SMS reminders through Telnyx. Anything other than SMS_MODE=live sends no
# text (the worker records "simulated"). Even live, a business only gets
# texts sent once its carrier registration is approved and recorded with
# scripts/sms-status.js, its SMS add-on is active and the client consented.
SMS_MODE=mock
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
# Account public key (Mission Control > Keys & Credentials > Public Key), to
# verify webhooks at https://<backend>/api/v1/messaging/telnyx/webhook
TELNYX_PUBLIC_KEY=
# Optional: per-message webhook URL (else the messaging profile's)
TELNYX_WEBHOOK_URL=
# Salt for the hashes of client phone numbers and IPs (opt-outs, consent evidence)
SMS_HASH_SALT=
