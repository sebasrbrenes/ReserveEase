# Copy to .env.local and adjust. VITE_* values are public (bundled into the browser).
VITE_BACKEND_URL=http://localhost:3001

# The landing (saas-booking-landing), where the privacy notice and the terms live.
VITE_LANDING_URL=https://reserve-ease-nwpq.vercel.app

# Local development against the Firebase emulators (npm run emulators at the repo root)
VITE_USE_EMULATORS=true

# Production only (leave VITE_USE_EMULATORS unset). From Firebase console:
# Project settings > General > Your apps > Web app config.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=reserveease-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=reserveease-prod
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Subscription checkout (Paddle). Public client-side token from Paddle >
# Developer tools > Authentication (a sandbox token while testing). Without it
# the settings screen says payments are not available yet.
# VITE_PADDLE_CLIENT_TOKEN=test_...
