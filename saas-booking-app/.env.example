# Copy to .env.local and adjust. VITE_* values are public (bundled into the browser).
VITE_BACKEND_URL=http://localhost:3001

# Local development against the Firebase emulators (npm run emulators at the repo root)
VITE_USE_EMULATORS=true

# Production only (leave VITE_USE_EMULATORS unset). From Firebase console:
# Project settings > General > Your apps > Web app config.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=reserveease-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=reserveease-prod
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
